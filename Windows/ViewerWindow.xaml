<Window x:Class="R2Cmd.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    Title="Viewer" Width="1000" Height="700"
    MinWidth="480" MinHeight="320"
    WindowStartupLocation="CenterOwner"
    FontFamily="Segoe UI" FontSize="{DynamicResource AppFontSize}"
    Background="{DynamicResource Brush.Background}"
    Foreground="{DynamicResource Brush.TextPrimary}"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewMouseWheel="Window_PreviewMouseWheel">

    <DockPanel>

        <!-- Fixed bottom bar: status left, search right -->
        <Border DockPanel.Dock="Bottom" Padding="8,2"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="65" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="0,0,16,0">

                    <TextBlock x:Name="txtStatusLeft"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource Brush.TextSecondary}" />

                    <TextBlock Text="  •  " Foreground="{DynamicResource Brush.TextSecondary}" />

                    <!-- Mode -->
                    <TextBlock x:Name="txtMode"
                        Cursor="Hand"
                        Padding="4,1"
                        MouseLeftButtonDown="TxtMode_MouseLeftButtonDown"
                        Foreground="{DynamicResource Brush.TextSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.TextPrimary}" />
                                        <Setter Property="Background"
                                            Value="{DynamicResource Brush.Hover}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="  •  " Foreground="{DynamicResource Brush.TextSecondary}" />

                    <!-- Encoding -->
                    <TextBlock x:Name="txtEncoding"
                        Cursor="Hand"
                        Padding="4,1"
                        MouseLeftButtonDown="TxtEncoding_MouseLeftButtonDown"
                        Foreground="{DynamicResource Brush.TextSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.TextPrimary}" />
                                        <Setter Property="Background"
                                            Value="{DynamicResource Brush.Hover}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock x:Name="txtStatusRight"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>

                <TextBlock x:Name="txtMatches" Grid.Column="1" VerticalAlignment="Center"
                    TextAlignment="Right"
                    Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextSecondary}" />

                <Button x:Name="btnPrev" Grid.Column="2" Content="↑" Width="24" Height="24"
                    Padding="0" Margin="0,0,2,0" Focusable="False" Click="BtnPrev_Click"
                    Cursor="Hand" />
                <Button x:Name="btnNext" Grid.Column="3" Content="↓" Width="24" Height="24"
                    Padding="0" Margin="0,0,8,0" Focusable="False" Click="BtnNext_Click"
                    Cursor="Hand" />

                <TextBox x:Name="txtFind" Grid.Column="4" Width="180" Height="24"
                    VerticalContentAlignment="Center" Padding="4,0" Margin="0"
                    Style="{DynamicResource Theme.TextBox}"
                    TextChanged="TxtFind_TextChanged" KeyDown="TxtFind_KeyDown" />
            </Grid>
        </Border>

        <!-- Content -->
        <Grid>
            <!-- Text, code, hex and messages (AvalonEdit) / rendered Markdown -->
            <Grid x:Name="codeHost" Visibility="Collapsed">
                <avalonEdit:TextEditor x:Name="avalonCodeViewer"
                    IsReadOnly="True"
                    ShowLineNumbers="True"
                    FontFamily="Cascadia Mono, Consolas, Courier New"
                    FontSize="{DynamicResource AppFontSize}"
                    WordWrap="False"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ContextMenu="{x:Null}"
                    Background="{x:Static SystemColors.WindowBrush}" />

                <FlowDocumentScrollViewer x:Name="docViewer"
                    Visibility="Collapsed"
                    Focusable="True"
                    FocusVisualStyle="{x:Null}"
                    BorderThickness="0"
                    ContextMenu="{x:Null}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    IsSelectionEnabled="True"
                    Background="{DynamicResource Brush.Background}" />
            </Grid>

            <!-- Image -->
            <ScrollViewer x:Name="imageScroll" Visibility="Collapsed"
                Focusable="True"
                FocusVisualStyle="{x:Null}"
                BorderThickness="0"
                ContextMenu="{x:Null}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Background="{DynamicResource Brush.Background}">
                <Image x:Name="imgContent" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
