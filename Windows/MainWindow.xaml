<Window x:Class="R2Cmd.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:R2Cmd.Controls"
    Title="R2cmd" Width="1440" Height="864"
    MinWidth="700" MinHeight="420"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="13"
    KeyDown="Window_KeyDown"
    PreviewKeyDown="Window_PreviewKeyDown"
    Closing="Window_Closing"
    Background="{DynamicResource Brush.Background}"
    Foreground="{DynamicResource Brush.TextPrimary}">

    <!-- Width/Height/WindowStartupLocation above are the first run defaults.
         Once a placement has been saved, RestoreWindowPlacement overrides all
         three from code before the window is shown. -->

    <Window.Resources>
        <!-- The implicit ListViewItem style that used to live here carried the
             ItemOpacity binding, but it never reached the panes: lvFiles sets its
             own ItemContainerStyle, and that style's BasedOn resolves in the
             control's own resource scope, which does not include this dictionary.
             The setter now sits on the pane's ItemContainerStyle, where it works. -->

        <Style TargetType="{x:Type GridViewColumnHeader}"
            BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border BorderThickness="0,0,1,0"
                            BorderBrush="{DynamicResource Brush.Border}" Padding="6,4">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                HorizontalAlignment="Left" />
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />          <!-- 0: Panes -->
            <RowDefinition Height="Auto" />       <!-- 1: Horizontal Splitter -->
            <RowDefinition x:Name="rowTerminal" Height="0" /> <!-- 2: Terminal Area -->
            <RowDefinition Height="Auto" />       <!-- 3: StatusBar -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <controls:FilePaneControl x:Name="leftPane" Grid.Column="0" />

            <!-- Panel Splitter. Named so the code-behind can hook it directly
                 instead of walking the visual tree, and ResizeDirection is stated
                 explicitly rather than left to Auto. Double click resets 50/50. -->
            <GridSplitter x:Name="paneSplitter" Grid.Column="1" Width="6"
                HorizontalAlignment="Stretch"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
                Focusable="False"
                ToolTip="Drag to resize, double click for 50% / 50%" />

            <!-- Right Panel -->
            <controls:FilePaneControl x:Name="rightPane" Grid.Column="2" />
        </Grid>

        <!-- Horizontal Splitter for Bottom Terminal -->
        <GridSplitter x:Name="bottomTerminalSplitter" Grid.Row="1" Height="4"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
            Focusable="False" Visibility="Collapsed"
            Background="{DynamicResource Brush.Border}" />

        <!-- Bottom Terminal Host -->
        <Border x:Name="bottomTerminalHost" Grid.Row="2" Visibility="Collapsed"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <!-- Global Windows Terminal -->
            <controls:TerminalControl x:Name="globalTerminal" Margin="4,0,4,4" />
        </Border>

        <!-- Main StatusBar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="statusText" Text="Ready." />
            </StatusBarItem>

            <!-- Background work reports here instead of fighting the main line:
                 a folder size scan keeps running while the user navigates, and
                 its progress must not be wiped by the pane's own messages -->
            <StatusBarItem>
                <TextBlock x:Name="backgroundText" Text="" Opacity="0.7"
                    Margin="16,0,0,0" />
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnSettings" Content="Editor" Click="OnSettingsClick"
                        PreviewMouseRightButtonUp="OnSettingsRightClick"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        Cursor="Hand" Padding="10,0" VerticalAlignment="Center"
                        Opacity="0.75" />
                    <Button x:Name="btnKeyboard" Content="Shortcuts" Click="OnKeyboardClick"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        Cursor="Hand" Padding="10,0" VerticalAlignment="Center"
                        Opacity="0.75" />
                    <Button x:Name="btnAbout" Content="About" Click="OnAboutClick"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        Cursor="Hand" Padding="10,0" VerticalAlignment="Center"
                        Opacity="0.75" />

                    <!-- Theme Switcher -->
                    <Button x:Name="btnTheme" Click="ThemeToggle_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        Cursor="Hand" Padding="8,0" VerticalAlignment="Center"
                        Opacity="0.75">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="Icon" Text="🌙" FontSize="13"
                                        VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1.0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
