<Window x:Class="R2Cmd.FavoriteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Favorite Directories" Width="600" Height="400"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    FontFamily="Segoe UI" FontSize="{DynamicResource AppFontSize}"
    Background="{DynamicResource Brush.Background}"
    Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="lstFavorites" Grid.Column="0"
            Grid.IsSharedSizeScope="True"
            HorizontalContentAlignment="Stretch"
            FocusVisualStyle="{x:Null}"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            Foreground="{DynamicResource Brush.TextPrimary}"
            AllowDrop="True"
            VirtualizingStackPanel.IsVirtualizing="False"
            MouseDoubleClick="OnFavoriteDoubleClick"
            PreviewMouseLeftButtonDown="LstFavorites_PreviewMouseLeftButtonDown"
            PreviewMouseMove="LstFavorites_PreviewMouseMove"
            DragOver="LstFavorites_DragOver"
            DragLeave="LstFavorites_DragLeave"
            Drop="LstFavorites_Drop">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="true">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource Brush.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource Brush.Selection}" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="Selector.IsSelectionActive"
                                                Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource Brush.SelectionInactive}" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FavNameCol" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0" />

                        <TextBlock Grid.Column="1" Text="{Binding Path}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Path}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="120">
            <Button Content="Remove" Margin="0,0,0,8" Padding="4,8" Click="BtnRemove_Click" />
            <Button Content="Edit" Margin="0,0,0,8" Padding="4,8" Click="BtnRename_Click" />
            <Button Content="Move Up" Margin="0,0,0,8" Padding="4,8" Click="BtnUp_Click" />
            <Button Content="Move Down" Margin="0,0,0,8" Padding="4,8" Click="BtnDown_Click" />
            <Button Content="Go (Enter)" Margin="0,0,0,8" Padding="4,8" IsDefault="True"
                Click="BtnGo_Click" />
            <Button Content="OK" Margin="0,0,0,8" Padding="4,8" Click="BtnOk_Click" />
            <Button Content="Cancel" Padding="4,8" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
