<!-- File: App.xaml | Path: App.xaml | Version: 2026-10-19.2 -->
<Application x:Class="R2Cmd.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0: Active color palette (Replaced dynamically by ThemeManager) -->
                <!-- FIXED: Updated path to match the new Themes folder -->
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />

                <!-- Index 1: Common control styles using DynamicResource references -->
                <!-- FIXED: Updated path to match the new Themes folder -->
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global element dimensions -->
            <sys:Double x:Key="AppFontSize">14</sys:Double>
            <sys:Double x:Key="AppRowHeight">22</sys:Double>

            <!-- File pane specific layout metrics -->
            <sys:Double x:Key="AppFilePaneFontSize">15</sys:Double>
            <sys:Double x:Key="AppFilePaneRowHeight">24</sys:Double>
            <sys:Double x:Key="AppFileIconSize">22</sys:Double>
            <sys:Double x:Key="AppFolderIconSize">22</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
