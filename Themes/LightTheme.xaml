<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Window and Surface Colors -->
    <Color x:Key="Color.Background">#FFF3F3F3</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFFAFAFA</Color>

    <!-- Interactive States -->
    <Color x:Key="Color.Hover">#FFEAEAEA</Color>
    <Color x:Key="Color.Border">#FFD1D1D1</Color>

    <!-- Typography -->
    <Color x:Key="Color.TextPrimary">#FF1A1A1A</Color>
    <Color x:Key="Color.TextSecondary">#FF616161</Color>
    <Color x:Key="Color.TextDisabled">#FF9E9E9E</Color>

    <!-- Accent Palette -->
    <Color x:Key="Color.Accent">#FF616161</Color>
    <Color x:Key="Color.AccentHover">#FF1A1A1A</Color>

    <!-- Selection and Cursor States -->
    <Color x:Key="Color.Selection">#FFE0E0E0</Color>
    <Color x:Key="Color.SelectionInactive">#FFEBEBEB</Color>

    <!-- Marked Files (Insert / Space) -->
    <Color x:Key="Color.MarkedText">#FFD08000</Color>

    <!-- ScrollBar Elements -->
    <Color x:Key="Color.ScrollThumb">#FFC2C2C2</Color>
    <Color x:Key="Color.ScrollThumbHover">#FF999999</Color>

    <!-- Feedback and Status -->
    <Color x:Key="Color.Danger">#FFD13438</Color>

    <!-- ===================== Terminal ===================== -->
    <!-- One Half Light, warmed slightly. The background is an off white with a
         touch of warmth instead of #FFFFFF, and the text is dark grey instead of
         black: about 8:1, comfortable for long sessions rather than maximal. -->
    <Color x:Key="Color.Terminal.Background">#FFF7F6F3</Color>
    <Color x:Key="Color.Terminal.Foreground">#FF444A54</Color>
    <Color x:Key="Color.Terminal.Cursor">#FF6B7280</Color>

    <!-- Standard xterm-256color palette (first 16 colors) -->
    <!-- Adapted for LIGHT background: bright colors are darkened to ensure contrast -->
    <Color x:Key="Color.Terminal.Ansi0">#FF000000</Color>
    <Color x:Key="Color.Terminal.Ansi1">#FFC01B1B</Color>
    <Color x:Key="Color.Terminal.Ansi2">#FF1A7F37</Color>
    <Color x:Key="Color.Terminal.Ansi3">#FF9A6700</Color>
    <Color x:Key="Color.Terminal.Ansi4">#FF055C9A</Color>
    <Color x:Key="Color.Terminal.Ansi5">#FFC01B5D</Color>
    <Color x:Key="Color.Terminal.Ansi6">#FF007777</Color>
    <Color x:Key="Color.Terminal.Ansi7">#FF333333</Color>
    <Color x:Key="Color.Terminal.Ansi8">#FF666666</Color>
    <Color x:Key="Color.Terminal.Ansi9">#FFD32F2F</Color>
    <Color x:Key="Color.Terminal.Ansi10">#FF2E7D32</Color>
    <Color x:Key="Color.Terminal.Ansi11">#FFB8860B</Color>
    <Color x:Key="Color.Terminal.Ansi12">#FF1565C0</Color>
    <Color x:Key="Color.Terminal.Ansi13">#FFC2185B</Color>
    <Color x:Key="Color.Terminal.Ansi14">#FF00838F</Color>
    <Color x:Key="Color.Terminal.Ansi15">#FF000000</Color>

    <!-- Dynamic Brush Mapping -->
    <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{DynamicResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{DynamicResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{DynamicResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.SelectionInactive"
        Color="{DynamicResource Color.SelectionInactive}" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{DynamicResource Color.ScrollThumb}" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="{DynamicResource Color.ScrollThumbHover}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.MarkedText" Color="{DynamicResource Color.MarkedText}" />

    <SolidColorBrush x:Key="Brush.Terminal.Background"
        Color="{DynamicResource Color.Terminal.Background}" />
    <SolidColorBrush x:Key="Brush.Terminal.Foreground"
        Color="{DynamicResource Color.Terminal.Foreground}" />
    <SolidColorBrush x:Key="Brush.Terminal.Cursor" Color="{DynamicResource Color.Terminal.Cursor}" />
</ResourceDictionary>
