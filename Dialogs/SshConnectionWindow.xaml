<!-- File: SshConnectionWindow.xaml | Path: Dialogs/SshConnectionWindow.xaml | Version: 2026-10-19 -->
<Window x:Class="R2Cmd.SshConnectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SSH Connection" Width="540" SizeToContent="Height"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
    FontFamily="Segoe UI" FontSize="{DynamicResource AppFontSize}"
    Background="{DynamicResource Brush.Background}"
    Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Session name:" VerticalAlignment="Center"
            Margin="0,0,10,8" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtName" Height="26" Margin="0,0,0,8"
            VerticalContentAlignment="Center" Padding="3,0" Style="{DynamicResource Theme.TextBox}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Host / IP:" VerticalAlignment="Center"
            Margin="0,0,10,8" />
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="txtHost" Height="26" VerticalContentAlignment="Center"
                Padding="3,0" Style="{DynamicResource Theme.TextBox}" />
            <TextBlock Grid.Column="1" Text="Port:" VerticalAlignment="Center" Margin="10,0,6,0" />
            <TextBox Grid.Column="2" x:Name="txtPort" Width="60" Height="26" Text="22"
                VerticalContentAlignment="Center" Padding="3,0"
                Style="{DynamicResource Theme.TextBox}" />
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Username:" VerticalAlignment="Center"
            Margin="0,0,10,8" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtUser" Height="26" Margin="0,0,0,8"
            VerticalContentAlignment="Center" Padding="3,0" Style="{DynamicResource Theme.TextBox}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Auth:" VerticalAlignment="Center"
            Margin="0,0,10,8" />
        <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
            <RadioButton x:Name="rbPassword" GroupName="Auth" Content="Password"
                VerticalAlignment="Center" Margin="0,0,20,0" Checked="AuthChanged" />
            <RadioButton x:Name="rbKey" GroupName="Auth" Content="Private key"
                VerticalAlignment="Center" Margin="0,0,20,0" Checked="AuthChanged" />
            <RadioButton x:Name="rbAgent" GroupName="Auth" Content="SSH agent (Bitwarden)"
                VerticalAlignment="Center" Checked="AuthChanged"
                ToolTip="Enable SSH agent in the Bitwarden desktop app and approve the key request when connecting." />
        </WrapPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" VerticalAlignment="Center"
            Margin="0,0,10,8" />
        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="pwdPassword" Height="26" Margin="0,0,0,8"
            VerticalContentAlignment="Center" Padding="3,0"
            Style="{DynamicResource Theme.PasswordBox}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Key file:" VerticalAlignment="Center"
            Margin="0,0,10,8" />
        <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="txtKeyPath" Height="26"
                VerticalContentAlignment="Center" Padding="3,0"
                Style="{DynamicResource Theme.TextBox}" />
            <Button Grid.Column="1" x:Name="btnBrowse"
                Width="38" Height="26" Margin="6,0,0,0"
                Padding="0" Click="BtnBrowse_Click">
                <TextBlock Text="…" FontSize="16" FontWeight="Bold"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
            </Button>
        </Grid>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Passphrase:" VerticalAlignment="Center"
            Margin="0,0,10,8" />
        <PasswordBox Grid.Row="6" Grid.Column="1" x:Name="pwdPassphrase" Height="26"
            Margin="0,0,0,8"
            VerticalContentAlignment="Center" Padding="3,0"
            Style="{DynamicResource Theme.PasswordBox}" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Remote dir:" VerticalAlignment="Center"
            Margin="0,0,10,8" />
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtRemote" Height="26" Margin="0,0,0,8"
            Text="/"
            VerticalContentAlignment="Center" Padding="3,0" Style="{DynamicResource Theme.TextBox}" />

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
            HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="90" Height="30" IsDefault="True" Margin="0,0,10,0"
                Click="BtnOk_Click" />
            <Button Content="Cancel" Width="90" Height="30" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
